# Beranda web server: the display page and the settings page, on port 8080.
#
# Deliberately does NOT "Wants=" network-online.target: Beranda already copes with having no
# network (cached data, a demo mode, and - when installed with --with-wifi-setup - a screen
# that shows a Wi-Fi network to join). Waiting for a network that may never come would only
# delay the screen that tells you how to give it one.
[Unit]
Description=Beranda dashboard server
After=network-online.target

[Service]
User=@USER@
Group=@USER@
Environment=BERANDA_CONFIG=@CONFDIR@/config.toml
Environment=BERANDA_REQUESTS=@STATEDIR@/requests
Environment=BERANDA_INSTALL_INFO=@CONFDIR@/install.env
Environment=BERANDA_WIFI_STATUS=@STATEDIR@/wifi-setup.json
ExecStart=@PREFIX@/venv/bin/beranda
Restart=always
RestartSec=3
# Hardening: the server only needs its own config, its cache and the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@CONFDIR@ @STATEDIR@

[Install]
WantedBy=multi-user.target

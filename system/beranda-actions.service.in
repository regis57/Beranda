# Carries out the requests of the settings page. Runs as root, but only ever runs the fixed
# actions of beranda-action: the web server itself never gets root rights.
[Unit]
Description=Beranda requests from the settings page

[Service]
Type=oneshot
# Commands are named, not written out in full: say exactly where root looks for them.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@PREFIX@/bin/beranda-action

#!/usr/bin/env bash
# Run the requests left by the settings page in the requests folder. Only these words are
# understood: update, restart-screen, reboot, reset. Anything else is deleted and ignored.
set -euo pipefail

# shellcheck source=/dev/null
source /etc/beranda/install.env  # PREFIX, BRANCH, USER, CONFDIR, STATEDIR
CONFDIR="${CONFDIR:-/etc/beranda}"  # older installs predate this line in install.env

requests="$STATEDIR/requests"
log() { echo "beranda-action: $*"; }

for file in "$requests"/*; do
    [ -e "$file" ] || continue
    action="$(basename "$file")"
    rm -f -- "$file"
    case "$action" in
        update)
            log "updating from branch $BRANCH"
            git -C "$PREFIX/src" fetch --depth 1 origin "$BRANCH"
            git -C "$PREFIX/src" reset --hard FETCH_HEAD
            # keep the SD card tidy: only the current version's files, no download caches
            git -C "$PREFIX/src" reflog expire --expire=now --all || true
            git -C "$PREFIX/src" gc --prune=now --quiet || true
            "$PREFIX/venv/bin/pip" install --quiet --no-cache-dir --upgrade "$PREFIX/src"
            rm -rf /root/.cache/pip "$PREFIX/src/build"
            apt-get clean || true
            install -m 0755 "$PREFIX/src/system/beranda-kiosk" "$PREFIX/bin/beranda-kiosk"
            install -m 0755 "$PREFIX/src/system/beranda-action" "$PREFIX/bin/beranda-action"
            sed -i "s/^COMMIT=.*/COMMIT=$(git -C "$PREFIX/src" rev-parse --short HEAD)/" /etc/beranda/install.env
            systemctl restart beranda.service
            systemctl try-restart beranda-kiosk.service
            ;;
        restart-screen)
            log "restarting the screen"
            systemctl try-restart beranda-kiosk.service
            ;;
        reboot)
            log "rebooting"
            systemctl reboot
            ;;
        reset)
            log "resetting to factory settings"
            rm -f -- "$CONFDIR/config.toml"
            systemctl restart beranda.service
            systemctl try-restart beranda-kiosk.service  # the port is back to 8080: the screen must follow
            ;;
        *)
            log "ignored unknown request: $action"
            ;;
    esac
done

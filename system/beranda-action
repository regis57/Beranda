#!/usr/bin/env bash
# Run the requests left by the settings page in the requests folder. Only these words are
# understood: update, restart-screen, reboot, reset; and Wi-Fi jobs (wifi-<id>.json), handed to
# beranda-wifi-job which checks them strictly. Anything else is deleted and ignored.
set -euo pipefail

# shellcheck source=/dev/null
source /etc/beranda/install.env  # PREFIX, BRANCH, USER, CONFDIR, STATEDIR
CONFDIR="${CONFDIR:-/etc/beranda}"  # older installs predate this line in install.env

requests="$STATEDIR/requests"
log() { echo "beranda-action: $*"; }

# The end of an update, run by the version just installed (see "update" below).
after_update() {
    # the Wi-Fi safety net, on by default: added to older installs, unless refused
    if [ "${WIFI_SETUP:-auto}" != 0 ] && [ ! -f /etc/systemd/system/beranda-wifi-setup.service ] \
        && systemctl is-active --quiet NetworkManager && nmcli -t -f TYPE device | grep -qx wifi; then
        sed -e "s|@PREFIX@|$PREFIX|g" -e "s|@STATEDIR@|$STATEDIR|g" \
            "$PREFIX/src/system/beranda-wifi-setup.service.in" > /etc/systemd/system/beranda-wifi-setup.service
        systemctl daemon-reload
        systemctl enable --now beranda-wifi-setup.service || true
        log "Wi-Fi safety net turned on"
    elif [ -f /etc/systemd/system/beranda-wifi-setup.service ]; then
        sed -e "s|@PREFIX@|$PREFIX|g" -e "s|@STATEDIR@|$STATEDIR|g" \
            "$PREFIX/src/system/beranda-wifi-setup.service.in" > /etc/systemd/system/beranda-wifi-setup.service
        systemctl daemon-reload
        systemctl try-restart beranda-wifi-setup.service || true
    fi
    # keep the SD card from filling up (caches, old versions, log size, swap file)
    env PREFIX="$PREFIX" "$PREFIX/bin/beranda-tidy" || true
    sed -i "s/^COMMIT=.*/COMMIT=$(git -C "$PREFIX/src" rev-parse --short HEAD)/" /etc/beranda/install.env
    systemctl restart beranda.service
    systemctl try-restart beranda-kiosk.service
    log "update finished"
}
if [ "${1:-}" = "--after-update" ]; then
    after_update
fi

for file in "$requests"/*; do
    [ -e "$file" ] || continue
    action="$(basename "$file")"
    if [[ "$action" =~ ^wifi-[0-9a-f]{12}\.json$ ]]; then
        # a Wi-Fi job from the settings page: the runner reads it, deletes it at once, answers
        BERANDA_WIFI_JOBS="$STATEDIR/wifi-jobs" "$PREFIX/venv/bin/beranda-wifi-job" "$file" || log "wifi job failed"
        rm -f -- "$file"
        continue
    fi
    rm -f -- "$file"
    case "$action" in
        update)
            log "updating from branch $BRANCH"
            git -C "$PREFIX/src" fetch --depth 1 origin "$BRANCH"
            git -C "$PREFIX/src" reset --hard FETCH_HEAD
            "$PREFIX/venv/bin/pip" install --quiet --no-cache-dir --upgrade "$PREFIX/src"
            install -m 0755 "$PREFIX/src/system/beranda-kiosk" "$PREFIX/bin/beranda-kiosk"
            install -m 0755 "$PREFIX/src/system/beranda-action" "$PREFIX/bin/beranda-action"
            install -m 0755 "$PREFIX/src/system/beranda-tidy" "$PREFIX/bin/beranda-tidy"
            # Everything after this point is done by the NEW version of this script: a running script
            # keeps reading its old copy, so new steps would otherwise only work one update later.
            exec "$PREFIX/bin/beranda-action" --after-update
            ;;
        restart-screen)
            log "restarting the screen"
            systemctl try-restart beranda-kiosk.service
            ;;
        reboot)
            log "rebooting"
            systemctl reboot
            ;;
        reset)
            log "resetting to factory settings"
            rm -f -- "$CONFDIR/config.toml"
            systemctl restart beranda.service
            systemctl try-restart beranda-kiosk.service  # the port is back to 8080: the screen must follow
            ;;
        *)
            log "ignored unknown request: $action"
            ;;
    esac
done

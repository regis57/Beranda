#!/usr/bin/env bash
# Run the requests left by the settings page in the requests folder. Only these words are
# understood: update, restart-screen, reboot, reset; and Wi-Fi jobs (wifi-<id>.json), handed to
# beranda-wifi-job which checks them strictly. Anything else is deleted and ignored.
set -euo pipefail

# This script runs as root, so nothing the web server's own user can write may decide what it
# does. Where Beranda lives is taken from where this script itself sits (it is installed as
# $PREFIX/bin/beranda-action, in a folder only root can write), and install.env is read as plain
# KEY=VALUE lines, never run as shell code. It used to sit in /etc/beranda, a folder the web
# server owns, and running it as code would have turned any file-writing bug in the web server
# into full control of the Pi.
PREFIX="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
REPO="https://github.com/regis57/Beranda.git"
INFO="$PREFIX/install.env"
LEGACY_INFO=/etc/beranda/install.env
BRANCH=main
CONFDIR=/etc/beranda
STATEDIR=/var/lib/beranda
USER_NAME=beranda
WIFI_SETUP=auto

log() { echo "beranda-action: $*"; }

# True when only root can change the file and the folder it sits in.
root_only() {
    local p
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    for p in "$1" "$(dirname "$1")"; do
        [ "$(stat -c %u "$p")" = 0 ] || return 1
        (( (8#$(stat -c %a "$p") & 8#022) == 0 )) || return 1
    done
}

# Only the known keys, and only values shaped like what install.sh writes: they end up in
# commands and unit files, so a stray character must never get through.
read_info() {
    local key value
    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            BRANCH) if [[ "$value" =~ ^[A-Za-z0-9._/-]+$ && "$value" != -* ]]; then BRANCH="$value"; fi ;;
            CONFDIR) if [[ "$value" =~ ^/[A-Za-z0-9._/-]+$ ]]; then CONFDIR="$value"; fi ;;
            STATEDIR) if [[ "$value" =~ ^/[A-Za-z0-9._/-]+$ ]]; then STATEDIR="$value"; fi ;;
            USER) if [[ "$value" =~ ^[a-z_][a-z0-9_-]*$ ]]; then USER_NAME="$value"; fi ;;
            WIFI_SETUP) if [[ "$value" =~ ^(0|1|auto)$ ]]; then WIFI_SETUP="$value"; fi ;;
        esac
    done < "$1"
}

if [ -e "$INFO" ]; then
    if ! root_only "$INFO"; then
        log "$INFO or its folder can be changed by someone other than root; doing nothing"
        exit 1
    fi
    read_info "$INFO"
elif [ -f "$LEGACY_INFO" ]; then
    # An install from before the move. Its values are still only read and checked, never run;
    # the next update moves the file to its new place (see after_update).
    read_info "$LEGACY_INFO"
fi

requests="$STATEDIR/requests"

render() {  # a unit file from its template in the installed source
    sed -e "s|@PREFIX@|$PREFIX|g" -e "s|@USER@|$USER_NAME|g" -e "s|@CONFDIR@|$CONFDIR|g" \
        -e "s|@STATEDIR@|$STATEDIR|g" "$PREFIX/src/system/$1.in" > "/etc/systemd/system/$1"
}

# The end of an update, run by the version just installed (see "update" below).
after_update() {
    # Older installs kept install.env in /etc/beranda, which the web server can write: move it
    # next to the programs, where only root can change it, and point the web server at it.
    if [ ! -e "$INFO" ]; then
        {
            echo "# Where Beranda lives. Only root may change this file: beranda-action trusts it."
            echo "PREFIX=$PREFIX"
            echo "BRANCH=$BRANCH"
            echo "USER=$USER_NAME"
            echo "CONFDIR=$CONFDIR"
            echo "STATEDIR=$STATEDIR"
            echo "WIFI_SETUP=$WIFI_SETUP"
            echo "COMMIT=unknown"
        } > "$INFO"
        chmod 0644 "$INFO"
        rm -f "$LEGACY_INFO"
    fi
    render beranda.service
    systemctl daemon-reload
    # the Wi-Fi safety net, on by default: added to older installs, unless refused
    if [ "${WIFI_SETUP:-auto}" != 0 ] && [ ! -f /etc/systemd/system/beranda-wifi-setup.service ] \
        && systemctl is-active --quiet NetworkManager && nmcli -t -f TYPE device | grep -qx wifi; then
        render beranda-wifi-setup.service
        systemctl daemon-reload
        systemctl enable --now beranda-wifi-setup.service || true
        log "Wi-Fi safety net turned on"
    elif [ "${WIFI_SETUP:-auto}" != 0 ] && [ -f /etc/systemd/system/beranda-wifi-setup.service ]; then
        render beranda-wifi-setup.service
        systemctl daemon-reload
        systemctl try-restart beranda-wifi-setup.service || true
    fi
    # keep the SD card from filling up (caches, old versions, log size, swap file)
    env PREFIX="$PREFIX" "$PREFIX/bin/beranda-tidy" || true
    sed -i "s/^COMMIT=.*/COMMIT=$(git -C "$PREFIX/src" rev-parse --short HEAD)/" "$INFO"
    systemctl restart beranda.service
    systemctl try-restart beranda-kiosk.service
    log "update finished"
}
if [ "${1:-}" = "--after-update" ]; then
    after_update
fi

for file in "$requests"/*; do
    [ -e "$file" ] || continue
    action="$(basename "$file")"
    if [[ "$action" =~ ^wifi-[0-9a-f]{12}\.json$ ]]; then
        # a Wi-Fi job from the settings page: the runner reads it, deletes it at once, answers
        BERANDA_WIFI_JOBS="$STATEDIR/wifi-jobs" "$PREFIX/venv/bin/beranda-wifi-job" "$file" || log "wifi job failed"
        rm -f -- "$file"
        continue
    fi
    rm -f -- "$file"
    case "$action" in
        update)
            log "updating from branch $BRANCH"
            # A copy made from the ready-to-flash image (or install.sh --source) has no git
            # history: make it a checkout of the repository so it updates like any other.
            if [ ! -d "$PREFIX/src/.git" ]; then
                git -C "$PREFIX/src" init -q
                git -C "$PREFIX/src" remote add origin "$REPO"
            fi
            git -C "$PREFIX/src" fetch --depth 1 origin "$BRANCH"
            git -C "$PREFIX/src" reset --hard FETCH_HEAD
            "$PREFIX/venv/bin/pip" install --quiet --no-cache-dir --upgrade "$PREFIX/src"
            install -m 0755 "$PREFIX/src/system/beranda-kiosk" "$PREFIX/bin/beranda-kiosk"
            install -m 0755 "$PREFIX/src/system/beranda-action" "$PREFIX/bin/beranda-action"
            install -m 0755 "$PREFIX/src/system/beranda-tidy" "$PREFIX/bin/beranda-tidy"
            # Everything after this point is done by the NEW version of this script: a running script
            # keeps reading its old copy, so new steps would otherwise only work one update later.
            exec "$PREFIX/bin/beranda-action" --after-update
            ;;
        restart-screen)
            log "restarting the screen"
            systemctl try-restart beranda-kiosk.service
            ;;
        reboot)
            log "rebooting"
            systemctl reboot
            ;;
        reset)
            log "resetting to factory settings"
            rm -f -- "$CONFDIR/config.toml"
            systemctl restart beranda.service
            systemctl try-restart beranda-kiosk.service  # the port is back to 8080: the screen must follow
            ;;
        *)
            log "ignored unknown request: $action"
            ;;
    esac
done

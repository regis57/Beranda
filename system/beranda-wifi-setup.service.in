# Beranda Wi-Fi safety net: watches the connection all the time. When there has been none for a
# while (no known Wi-Fi in range, a changed password, a new box...), the Pi opens its own Wi-Fi
# "Beranda setup" so a phone can pick the right network, with no keyboard, screen cable or
# terminal. Installed by default on systems that use NetworkManager (Raspberry Pi OS); opt out
# with install.sh --no-wifi-setup. Needs root, unlike the main Beranda server, because only root
# can create a Wi-Fi access point.
[Unit]
Description=Beranda Wi-Fi setup (access point if no network is found)
After=NetworkManager.service
Wants=NetworkManager.service
Before=beranda.service

[Service]
Type=simple
Environment=BERANDA_WIFI_STATUS=@STATEDIR@/wifi-setup.json
ExecStart=@PREFIX@/venv/bin/beranda-wifi-setup
Restart=always
RestartSec=10
# Hardening: still needs real root (nmcli, iptables-free dnsmasq config, binding port 80), so
# this is the one Beranda service NOT sandboxed with ProtectSystem=strict.

[Install]
WantedBy=multi-user.target

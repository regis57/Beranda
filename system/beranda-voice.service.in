# Beranda voice control: an optional, fully offline wake-word + speech service. Only written
# by install.sh --with-voice, and only enabled by hand once a Vosk model and a Piper voice
# have been placed under @STATEDIR@/voice (see the README) and voice control is turned on on
# the settings page.
[Unit]
Description=Beranda voice control
After=beranda.service sound.target
Wants=beranda.service

[Service]
User=@USER@
Group=@USER@
Environment=BERANDA_CONFIG=@CONFDIR@/config.toml
ExecStart=@PREFIX@/venv/bin/beranda-voice --vosk-model @STATEDIR@/voice/vosk-model --piper-model @STATEDIR@/voice/piper-voice.onnx
Restart=always
RestartSec=5
SupplementaryGroups=audio
# Hardening: this only needs the config, the models under STATEDIR, and the sound devices.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@STATEDIR@

[Install]
WantedBy=multi-user.target

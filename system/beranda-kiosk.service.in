# Beranda screen: a full-screen browser (Chromium inside the Cage kiosk compositor) on the
# HDMI output, started on the first console instead of the login prompt.
[Unit]
Description=Beranda screen (kiosk)
After=systemd-user-sessions.service plymouth-quit-wait.service beranda.service
Wants=beranda.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -d -- @PREFIX@/bin/beranda-kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
